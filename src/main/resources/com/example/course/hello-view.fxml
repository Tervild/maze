<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane prefHeight="862.0" prefWidth="1400.0" style="-fx-background-color: #ff8e1c;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.course.MainController">
    <children>
        <TextField fx:id="widthField" layoutX="20.0" layoutY="730.0" prefHeight="30.0" prefWidth="100.0" promptText="M (ширина)" />
        <TextField fx:id="heightField" layoutX="130.0" layoutY="730.0" prefHeight="30.0" prefWidth="100.0" promptText="N (висота)" />
        <Button fx:id="build" layoutX="240.0" layoutY="730.0" mnemonicParsing="false" onAction="#onBuild" prefHeight="30.0" prefWidth="100.0" text="Побудувати" />
        <Button fx:id="buildMax" layoutX="350.0" layoutY="730.0" mnemonicParsing="false" onAction="#onBuildMax" prefHeight="30.0" prefWidth="100.0" text="Максимум" />
        <Button fx:id="clear" layoutX="631.0" layoutY="730.0" mnemonicParsing="false" onAction="#onClear" prefHeight="30.0" prefWidth="100.0" text="Очистити">
            <font>
                <Font name="Arial" size="12.0" />
            </font>
        </Button>
        <Button fx:id="algorithmone" layoutX="741.0" layoutY="730.0" mnemonicParsing="false" onAction="#onAlgorithmOne" prefHeight="30.0" prefWidth="100.0" text="Алгоритм 1" />
        <Button fx:id="algorithmtwo" layoutX="850.0" layoutY="730.0" mnemonicParsing="false" onAction="#onAlgorithmTwo" prefHeight="30.0" prefWidth="100.0" text="Алгоритм 2" />
        <Button fx:id="path" layoutX="960.0" layoutY="730.0" mnemonicParsing="false" onAction="#onPath" prefHeight="30.0" prefWidth="100.0" text="Шлях" />
        <Button fx:id="cleartime" layoutX="1069.0" layoutY="730.0" mnemonicParsing="false" onAction="#onClearRunTime" prefHeight="30.0" prefWidth="100.0" text="Очистити">
            <font>
                <Font name="Arial" size="12.0" />
            </font>
        </Button>
        <TextField fx:id="rntime1" editable="false" layoutX="1178.0" layoutY="730.0" prefHeight="30.0" prefWidth="100.0" promptText="Час Алгор. 1" />
        <TextField fx:id="rntime2" editable="false" layoutX="1286.0" layoutY="730.0" prefHeight="30.0" prefWidth="100.0" promptText="Час Алгор. 2" />
      <Button fx:id="startgame" layoutX="520.0" layoutY="730.0" mnemonicParsing="false" onAction="#onStartGame" prefHeight="30.0" prefWidth="100.0" text="Почати гру" />
    </children>
</Pane>
